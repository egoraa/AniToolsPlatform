/// @file
/// Namespace documentation. It lives apart from the headers because doxygen drops an undocumented
/// namespace together with everything declared directly in it — the free functions, enums and
/// constants that are part of the API. The `detail` namespaces are deliberately left undocumented,
/// which keeps their internals out of the reference.

/// The platform SDK: modules, their ports, factories, the registry and the plugin contract.
namespace atp {

/// The config data vocabulary: one node of a config tree, its kind, the malformed-config error and
/// the typed reads with a fallback.
namespace config {}

/// The io layer: inputs, outputs and properties, their registries and the polling watcher.
namespace io {}

/// The host runtime: the composite and the pipeline, the runner that owns the threads, the plugin
/// loader, the log ring and pump, and the config subsystem that builds a pipeline from a document.
namespace runtime {}

/// The studio core, independent of any GUI toolkit: the editable project, the module manager and
/// the run session.
namespace studio {

/// The Qt layer of studio: the main window, the canvas and the docked panels.
namespace ui {}

}  // namespace studio

}  // namespace atp
