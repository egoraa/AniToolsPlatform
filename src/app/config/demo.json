{
    "version": "3.3",
    "plugins": ["../plugins/atp_demo_plugin"],
    "configs": {
        "printing": {
            "show": ["value", "measure", "sample"],
            "names": { "value": "n", "measure": "m" }
        }
    },
    "pipeline": {
        "modules": [
            {
                "group": "producers",
                "modules": [
                    {
                        "module": "counter",
                        "name": "ticks",
                        "version": "1.0",
                        "properties": { "start_at": 100, "step": 5 },
                        "config": {
                            "milestones": [
                                { "at": 110, "say": "one hundred and ten" }
                            ]
                        }
                    },
                    {
                        "module": "scaler",
                        "name": "scale",
                        "properties": { "gain": 0.25 },
                        "config": "file:rig.ini"
                    }
                ],
                "connections": [
                    { "from": "ticks.count", "to": "scale.count" }
                ],
                "expose": {
                    "outputs": {
                        "numbers": "ticks.count",
                        "labels": "ticks.label",
                        "measures": "scale.value",
                        "samples": "scale.sample"
                    }
                }
            },
            { "$include": "demo_consumers.json" }
        ],
        "connections": [
            { "from": "producers.numbers", "to": "consumers.numbers" },
            { "from": "producers.labels", "to": "consumers.labels" },
            { "from": "producers.labels", "to": "consumers.probe" },
            { "from": "producers.measures", "to": "consumers.measures" },
            { "from": "producers.samples", "to": "consumers.samples" }
        ]
    },
    "threads": [
        { "name": "producing", "mode": "throttled", "period_ms": 500 },
        { "name": "consuming", "mode": "on_demand" }
    ],
    "assign": { "producers": "producing", "consumers": "consuming" }
}
