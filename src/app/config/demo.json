{
    "version": "1.1",
    "plugins": ["atp_demo_plugin"],
    "pipeline": {
        "children": [
            {
                "group": "producers",
                "children": [
                    {
                        "module": "counter",
                        "name": "ticks",
                        "version": "1.0",
                        "properties": { "start_at": 100, "step": 5 }
                    }
                ],
                "expose": { "outputs": { "numbers": "ticks.count" } }
            },
            { "$include": "demo_consumers.json" }
        ],
        "connections": [
            { "from": "producers.numbers", "to": "consumers.numbers" }
        ]
    },
    "threads": [
        { "name": "producing", "mode": "throttled", "period_ms": 500 },
        { "name": "consuming", "mode": "on_demand" }
    ],
    "assign": { "producers": "producing", "consumers": "consuming" }
}
