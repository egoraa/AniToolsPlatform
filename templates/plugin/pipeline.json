{
    "version": "3.2",
    "plugins": ["../plugins/atp_demo_plugin", "../plugins/atp_template_plugin"],
    "pipeline": {
        "modules": [
            {
                "module": "counter",
                "name": "ticks",
                "properties": { "start_at": 1, "step": 1 }
            },
            {
                "module": "doubler",
                "name": "scale",
                "properties": { "factor": 3 },
                "config": {
                    "bands": [
                        { "upto": 10, "name": "small" },
                        { "upto": 30, "name": "medium" }
                    ],
                    "otherwise": "large"
                }
            },
            {
                "module": "printer",
                "name": "sink",
                "properties": { "tag": "sink" }
            }
        ],
        "connections": [
            { "from": "ticks.count", "to": "scale.value" },
            { "from": "scale.report", "to": "sink.label" }
        ]
    },
    "threads": [
        { "name": "main", "mode": "throttled", "period_ms": 100 }
    ]
}
