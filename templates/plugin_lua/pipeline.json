{
    "version": "3.0",
    "plugins": ["../plugins/atp_demo_plugin", "../plugins/atp_lua_bridge"],
    "pipeline": {
        "modules": [
            {
                "module": "counter",
                "name": "ticks",
                "properties": { "start_at": 1, "step": 2 }
            },
            {
                "module": "lua_scale",
                "name": "scale",
                "properties": { "factor": 5 }
            },
            {
                "module": "printer",
                "name": "sink",
                "properties": { "tag": "sink" }
            }
        ],
        "connections": [
            { "from": "ticks.count", "to": "scale.value" },
            { "from": "scale.result", "to": "sink.value" },
            { "from": "scale.label", "to": "sink.label" }
        ]
    },
    "threads": [
        { "name": "main", "mode": "throttled", "period_ms": 100 }
    ]
}
