{
    "version": "3.2",
    "plugins": ["../plugins/atp_demo_plugin", "../plugins/atp_python_bridge"],
    "pipeline": {
        "modules": [
            {
                "module": "counter",
                "name": "ticks",
                "properties": { "start_at": 1, "step": 2 }
            },
            {
                "module": "py_averager",
                "name": "mean",
                "properties": { "window": 4, "mode": "verbose" },
                "config": { "weights": [1, 2, 3, 4] }
            },
            {
                "module": "printer",
                "name": "sink",
                "properties": { "tag": "sink" }
            }
        ],
        "connections": [
            { "from": "ticks.count", "to": "mean.value" },
            { "from": "mean.report", "to": "sink.label" },
            { "from": "mean.mean", "to": "sink.measure" }
        ]
    },
    "threads": [
        { "name": "main", "mode": "throttled", "period_ms": 100 }
    ]
}
